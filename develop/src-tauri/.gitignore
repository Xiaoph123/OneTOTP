# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android 前端产物会注入到 assets，属构建产物不入库（其余构建目录由
# gen/android/.gitignore 覆盖：build、.gradle 等）
/gen/android/app/src/main/assets

# Android 签名密钥库与签名配置：属敏感凭证，严禁入库
/gen/android/*.keystore
/gen/android/*.jks
/gen/android/key.properties
/gen/android/keystore.properties
