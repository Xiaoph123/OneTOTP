{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneTotp",
  "version": "0.1.0",
  "identifier": "com.wanghao.onetotp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneTotp",
        "width": 400,
        "height": 720,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#FCFDFE"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
